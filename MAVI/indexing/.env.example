# Copie este arquivo para ".env" (sem o ".example") e preencha com seus valores.
# O arquivo .env NUNCA deve ser enviado ao GitHub (adicione ".env" ao .gitignore).

# --- Conexao com o banco de dados ---
MAVI_DB_HOST=localhost
MAVI_DB_PORT=5432
MAVI_DB_NAME=mavi
MAVI_DB_USER=postgres
MAVI_DB_PASSWORD=postgres

# --- Provider de embeddings (busca semantica) ---
# Valores possiveis: none | local | openai | voyage | gemini
MAVI_EMBEDDING_PROVIDER=local

# Preencha SOMENTE a chave do provider que voce escolheu acima.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Voyage AI (https://dash.voyageai.com/api-keys)
VOYAGE_API_KEY=

# Google Gemini - GRATUITO, sem cartao (https://aistudio.google.com)
GEMINI_API_KEY=
